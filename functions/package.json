{
  "name": "jetalpur-dham-functions",
  "private": true,
  "description": "Cloud Functions for the Jetalpur Dham app: automatic content from Storage uploads, push notifications and donation alerts.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "gcp-build": "",
    "build:watch": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "node --test \"lib/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
